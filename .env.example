# Langfuse credentials.
# Get them at https://cloud.langfuse.com -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse base URL.
#   EU cloud: https://cloud.langfuse.com
#   US cloud: https://us.cloud.langfuse.com
#   Self-hosted: your own deployment URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: explicit path to a .env file to load instead of ./.env
# LANGFUSE_ENV_FILE=/absolute/path/to/.env
